# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Agent scratch space. Probe scripts written while investigating a bug are working files, not part
# of the product, and they hard-code one developer's paths.
.dsh-scratch/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# .NET build products. third_party/gamehelper vendors upstream *sources*; its bin/ and obj/ trees are
# restored from NuGet on every build and were never meant to be committed.
[Bb]in/
[Oo]bj/
*.userprefs
*.nupkg

# Locally produced release bundles. The GitHub Actions release workflow builds these itself.
/dist/
/release/
*.zip
*.sha256

# Private Qiandao RMT price adapter (contains reverse-engineered signing details).
/qiandao/
