<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>tracker_host</AssemblyName>
    <RootNamespace>LootTracker.App</RootNamespace>
    <Version>1.0.7</Version>
    <InformationalVersion>1.0.7+8</InformationalVersion>
    <FileVersion>1.0.7.8</FileVersion>
    <AssemblyVersion>1.0.7.8</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\third_party\gamehelper\GameHelper\GameHelper.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\metaArt.json" CopyToOutputDirectory="PreserveNewest" Link="metaArt.json" />
    <None Include="Assets\Localization\*.json" CopyToOutputDirectory="PreserveNewest" Link="Localization\%(Filename)%(Extension)" />
    <None Include="Assets\icons\*.png" CopyToOutputDirectory="PreserveNewest" Link="icons\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
